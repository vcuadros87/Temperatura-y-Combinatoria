body {
  font-family: Arial, sans-serif;
  background: #e3bcd9;
  display: flex;
  justify-content: center;
  padding: 40px 16px;
}

.contenedor {
  background: white;
  border: 1px solid #ccc;
  border-radius: 8px;
  padding: 24px;
  width: 100%;
  max-width: 400px;
}

h2 {
  text-align: center;
  margin-bottom: 6px;
  color: #80006f;
}


label {
  display: block;
  margin-bottom: 4px;
  font-size: 14px;
}

input[type="number"] {
  width: 96%;
  padding: 7px 7px 7px 7px;
  margin-bottom: 14px;
  border: 1px solid #ecbae3;
  border-radius: 4px;
  font-size: 15px;
}

button {
  width: 100%;
  padding: 9px;
  background: #8722a5;
  color: white;
  border: none;
  border-radius: 4px;
  font-size: 16px;
  cursor: pointer;
  margin-bottom: 8px;
}

button:hover {
  background: #b82faf;
}

#btnReset {
  background: #aaa;
}

#btnReset:hover { background: #dc9acf; }

#resultado {
  text-align: center;
  margin-top: 16px;
  font-size: 17px;
  display: none;
}

#resultado span {
  font-weight: bold;
  color: #d53a9a;
}

#error {
  color: #ff00ff;
  font-size: 14px;
  text-align: center;
  margin-top: 8px;
  display: none;
}
